<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>$(AssemblyName)</PackageId>
    <Title>Remontoire.Engine</Title>
    <Description>Remontoire's engine: storage, Raft, messaging and retention. Runs embedded in one process with AddEmbedded, and underlies Remontoire.Cluster and Remontoire.Server.</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Remontoire\Remontoire.csproj" />
    <ProjectReference Include="..\Remontoire.Grpc\Remontoire.Grpc.csproj" />
    <ProjectReference Include="..\Remontoire.Storage\Remontoire.Storage.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Remontoire.Raft\Remontoire.Raft.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Remontoire.Messaging\Remontoire.Messaging.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Remontoire.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Bundle the private implementation assemblies into the package's lib folder: they are not
       packages of their own, so a package dependency on them would not resolve. Remontoire.Server
       and Remontoire.Cluster get them through this package. -->
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);GetPrivateAssembliesForPack</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <Target Name="GetPrivateAssembliesForPack" Returns="@(BuildOutputInPackage)">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)Remontoire.Storage.dll" Condition="Exists('$(OutputPath)Remontoire.Storage.dll')" />
      <BuildOutputInPackage Include="$(OutputPath)Remontoire.Raft.dll" Condition="Exists('$(OutputPath)Remontoire.Raft.dll')" />
      <BuildOutputInPackage Include="$(OutputPath)Remontoire.Messaging.dll" Condition="Exists('$(OutputPath)Remontoire.Messaging.dll')" />
    </ItemGroup>
  </Target>

</Project>
